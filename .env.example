# Copy to .env.local and fill in. Everything is optional — the app works without keys
# (on-device colour detection + manual tagging + rules-based outfit engine).

# Enables AI tagging, flat-lay splitting, inspiration analysis and stylist picks.
ANTHROPIC_API_KEY=

# Optional: override the Claude model (defaults to claude-opus-5-5).
# A smaller model is cheaper for high-volume photo tagging.
BGADAI_MODEL=

# Optional: real product results for "Shop similar" via SerpApi's Google Shopping engine.
# Without it, the app shows Google Shopping / Vinted / Pinterest search links.
SERPAPI_API_KEY=
